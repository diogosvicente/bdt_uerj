{
  // Perfis prontos para "Run and Debug" (Ctrl+Shift+D).
  // Selecione um no dropdown e aperte F5.
  //
  // O switch de ambiente voltou em 2026-08-04, junto com o
  // `--dart-define=API_BASE_URL` no lib/api/api_client.dart, para permitir
  // desenvolver contra o backend local rodando no Docker.
  //
  // REGRA: produção é o PADRÃO. Sem `--dart-define`, o app aponta para
  // www.e-prefeitura.uerj.br. Só o comando de build desvia — o código nunca
  // fica commitado apontando para a máquina de alguém.
  "version": "0.2.0",
  "configurations": [
    {
      // Backend: produção (www.e-prefeitura.uerj.br).
      "name": "Debug — produção",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      // Backend: LOCAL, visto de dentro do EMULADOR.
      //
      // 10.0.2.2 é o alias que o emulador Android cria para a máquina host.
      // `localhost` aqui seria o próprio emulador — não o seu Apache.
      //
      // Requer: Docker do e-prefeitura no ar (porta 80).
      "name": "Debug — localhost (emulador)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=API_BASE_URL=http://10.0.2.2/e-prefeitura"
      ]
    },
    {
      // Backend: LOCAL, para APARELHO FÍSICO via USB.
      //
      // Exige rodar ANTES (uma vez por conexão do aparelho):
      //     adb reverse tcp:80 tcp:80
      // Isso faz o `localhost` do aparelho apontar para a porta 80 do PC.
      "name": "Debug — localhost (aparelho USB, adb reverse)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=API_BASE_URL=http://localhost/e-prefeitura"
      ]
    },
    {
      // Mesmo que o primeiro, mas em modo profile (perf + debugging visual).
      "name": "Profile — produção",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    },
    {
      // Escape hatch do MSEC.5: desliga o certificate pinning para permitir
      // proxy de inspeção (Charles, mitmproxy). Use só para depurar tráfego;
      // nunca para distribuir build.
      "name": "Debug — produção (sem SSL pinning)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=SSL_PINNING=off"
      ]
    }
  ]
}
